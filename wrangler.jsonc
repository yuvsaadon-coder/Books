// הגדרות הפרסום של השרת ב-Cloudflare (Workers Builds). השרת עצמו נמצא ב-worker/worker.js.
// הקובץ נמצא גם בשורש המאגר כדי שהבנייה תעבוד בלי לשנות Root directory בהגדרות של Cloudflare.
{
  "name": "books",
  "main": "worker/worker.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  // לא למחוק משתנים שהוגדרו בלוח הבקרה של Cloudflare בכל פרסום
  "keep_vars": true,
  // בזמן הבנייה: העברת ANTHROPIC_API_KEY מ-Build secrets לסודות של השרת
  "build": { "command": "sh worker/sync-secrets.sh" },
  // עבודות רקע: המלצה ממשיכה לרוץ בשרת גם כשהטלפון כבוי (Durable Object עם אחסון SQLite, זמין גם בתוכנית החינמית)
  // Store: אחסון עקבי לסנכרון, לסיסמאות ולמונים (KV מחזיר לפעמים עותק ישן). מופע אחד בשם main
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "AiJob" }, { "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiJob"] }, { "tag": "v2", "new_sqlite_classes": ["Store"] }],
  // ההצעות הדו-שבועיות: בדיקה כל שעה למי הגיע הזמן
  "triggers": { "crons": ["17 * * * *"] },
  "kv_namespaces": [
    { "binding": "LIBRARY", "id": "b622c3fe36394ceaa0b02718aaf676b3" }
  ]
}
